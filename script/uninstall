#!/usr/bin/env bash
#
# Remove every symlink in $HOME that points into this dotfiles repo:
# ~/.<name> (*.symlink files), ~/.ssh/config, and ~/.config/**.
# Does not touch Homebrew packages or any generated files (~/.gitconfig.local etc).

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -euo pipefail

echo ''

# shellcheck source=script/lib/output.sh
# shellcheck disable=SC1091
source "$DOTFILES_ROOT/script/lib/output.sh"

info "Removing dotfile symlinks from $HOME"

removed=0

# Remove ~/.<name> symlinks created by bootstrap (*.symlink files)
while IFS= read -r src; do
  dst="$HOME/.$(basename "${src%.*}")"
  if [ -L "$dst" ] && [[ "$(readlink "$dst")" == "$DOTFILES_ROOT/"* ]]; then
    rm "$dst"
    success "removed $dst"
    removed=$((removed + 1))
  fi
done < <(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*/.git/*')

# Remove ~/.ssh/config if it points into the repo
if [ -L "$HOME/.ssh/config" ] && [[ "$(readlink "$HOME/.ssh/config")" == "$DOTFILES_ROOT/"* ]]; then
  rm "$HOME/.ssh/config"
  success "removed ~/.ssh/config"
  removed=$((removed + 1))
fi

# Remove ~/.config/** symlinks created by install_config_files
while IFS= read -r link; do
  if [ -L "$link" ] && [[ "$(readlink "$link")" == "$DOTFILES_ROOT/"* ]]; then
    rm "$link"
    success "removed $link"
    removed=$((removed + 1))
  fi
done < <(find "$HOME/.config" -type l 2>/dev/null)

echo ''
info "Done. Removed $removed symlink(s)."
info "Homebrew packages, ~/.gitconfig.local, and ~/.mackup.cfg were left untouched."
echo ''
