#!/usr/bin/env bash
#
# Run all dotfiles installers.

set -e

cd "$(dirname "$0")"/..  

# App groups (Brewfile.<group>) - see README "app groups".
DOTFILES_ROOT="$(pwd -P)"
# shellcheck source=script/lib/groups.sh
# shellcheck disable=SC1091
source "$DOTFILES_ROOT/script/lib/groups.sh"

# Intel Macs install ports instead of Brewfile formulae.
if [ -f "$DOTFILES_ROOT/script/lib/legacy-intel.sh" ]; then
  # shellcheck source=script/lib/legacy-intel.sh
  # shellcheck disable=SC1091
  source "$DOTFILES_ROOT/script/lib/legacy-intel.sh"
fi

available="$(dotfiles_available_groups_line)"
requested="$(dotfiles_requested_groups)"

# Validate every requested group before installing anything.
unknown="$(dotfiles_unknown_groups)"
if [ -n "$unknown" ]; then
  if [ "$(dotfiles_groups_source)" = env ]; then
    while IFS= read -r g; do
      echo "Unknown group '$g' in \$DOTFILES_GROUPS. Available: $available" >&2
    done <<<"$unknown"
  else
    while IFS= read -r g; do
      echo "Unknown group '$g' in ~/.localgroups. Available: $available" >&2
    done <<<"$unknown"
  fi
  exit 1
fi

if [ -z "$requested" ]; then
  echo "› no app group selected - installing shared apps only (available: $available; create ~/.localgroups to install one)"
fi

if [ "${DOTFILES_LEGACY_INTEL:-0}" = "1" ]; then
  # A CI smoke runner can be Intel without MacPorts - exit cleanly there.
  if ! command -v port >/dev/null 2>&1; then
    echo "› Install MacPorts from https://www.macports.org/install.php, then re-run script/install"
    exit 0
  fi
  dotfiles_intel_install_ports
else
  echo "› brew bundle"
  brew bundle --verbose --no-upgrade --file=Brewfile

  while IFS= read -r g; do
    [ -n "$g" ] || continue
    echo "› brew bundle (group: $g)"
    brew bundle --verbose --no-upgrade --file="Brewfile.$g"
  done <<<"$requested"
fi

# find the installers and run them iteratively
find . -maxdepth 2 -name .git -prune -o -name install.sh -type f -print | sort | while IFS= read -r installer; do
  echo "› $installer"
  "$installer"
done
