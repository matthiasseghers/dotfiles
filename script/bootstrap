#!/usr/bin/env bash
#
# bootstrap installs things.

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd -P)

set -e
# Detect failures of `if cmd | while read ...` pipelines (pipe status of the
# last command would otherwise mask a failing first command).
set -o pipefail

echo ''

# shellcheck source=script/lib/output.sh
# shellcheck disable=SC1091
source "$DOTFILES_ROOT/script/lib/output.sh"

# Arch detection plus the group helpers (the Intel dependency branch needs both).
if [ -f "$DOTFILES_ROOT/script/lib/legacy-intel.sh" ]; then
  # shellcheck source=script/lib/legacy-intel.sh
  # shellcheck disable=SC1091
  source "$DOTFILES_ROOT/script/lib/legacy-intel.sh"
fi

if [ -f "$DOTFILES_ROOT/script/lib/groups.sh" ]; then
  # shellcheck source=script/lib/groups.sh
  # shellcheck disable=SC1091
  source "$DOTFILES_ROOT/script/lib/groups.sh"
fi

setup_gitconfig () {
  if ! [ -f git/gitconfig.local.symlink ]
  then
    info 'setup gitconfig'

    user ' What is your github author name?'
    read -re git_authorname
    user ' What is your github author email?'
    read -re git_authoremail

    sed -e "s/AUTHORNAME/$git_authorname/g" -e "s/AUTHOREMAIL/$git_authoremail/g" \
      git/gitconfig.local.symlink.example > git/gitconfig.local.symlink

    success 'gitconfig'
  fi
}

link_file () {
  local src=$1 dst=$2

  local overwrite='' backup='' skip=''
  local action=''

  if [ -f "$dst" ] || [ -d "$dst" ] || [ -L "$dst" ]
  then

    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then

      local currentSrc
      currentSrc="$(readlink "$dst")"

      if [ "$currentSrc" == "$src" ]
      then

        skip=true;

      else

        user "File already exists: $dst ($(basename "$src")), what do you want to do?
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -rn 1 action < /dev/tty

        case "$action" in
          o )
            overwrite=true;;
          O )
            overwrite_all=true;;
          b )
            backup=true;;
          B )
            backup_all=true;;
          s )
            skip=true;;
          S )
            skip_all=true;;
          * )
            skip=true;;
        esac

      fi

    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    ln -s "$1" "$2"
    success "linked $1 to $2"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  while IFS= read -r src; do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done < <(find -H "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -not -path '*/.git/*')
}

install_config_files () {
  info 'installing ~/.config files'

  while IFS= read -r src; do
    # Derive topic from the first path component after DOTFILES_ROOT
    local rel="${src#"$DOTFILES_ROOT"/}"
    local topic="${rel%%/*}"
    # Derive path within config/ (strip <topic>/config/)
    local subpath="${rel#"$topic"/config/}"
    local dst="$HOME/.config/$topic/$subpath"
    mkdir -p "$(dirname "$dst")"
    link_file "$src" "$dst"
  done < <(find -H "$DOTFILES_ROOT" -mindepth 3 -type f -path '*/config/*' -not -path '*/.git/*' -not -name '*.symlink' -not -name '.DS_Store')
}

# MacPorts has no cask equivalent: on Intel, print the cask entries from the
# shared Brewfile and every selected group so they can be installed by hand.
print_cask_checklist () {
  local file g line
  info 'GUI apps to install by hand (cask entries from the Brewfiles):'

  while IFS= read -r line; do
    info "  $line"
  done < <(grep -h '^cask ' "$DOTFILES_ROOT/Brewfile" 2>/dev/null || true)

  while IFS= read -r g; do
    [ -n "$g" ] || continue
    file="$DOTFILES_ROOT/Brewfile.$g"
    [ -f "$file" ] || continue
    while IFS= read -r line; do
      info "  $line"
    done < <(grep -h '^cask ' "$file" 2>/dev/null || true)
  done < <(dotfiles_requested_groups)
}

setup_gitconfig
overwrite_all=false
backup_all=false
skip_all=false
install_dotfiles
install_config_files

# If we're on a Mac, apply macOS defaults, set hostname, and install dependencies
if [ "$(uname -s)" == "Darwin" ]
then
  info "applying macOS defaults"
  if "$DOTFILES_ROOT/macos/set-defaults.sh"
  then
    success "macOS defaults applied"
  else
    fail "error applying macOS defaults"
  fi

  info "applying macOS security defaults"
  if "$DOTFILES_ROOT/macos/set-security-defaults.sh" 2>&1 | while read -r data; do info "$data"; done
  then
    success "macOS security defaults applied"
  else
    fail "error applying macOS security defaults (run sudo macos/set-security-defaults.sh manually)"
  fi

  info "setting hostname"
  if "$DOTFILES_ROOT/macos/set-hostname.sh"
  then
    success "hostname set"
  else
    fail "error setting hostname"
  fi

  info "installing dependencies"
  if [ "${DOTFILES_LEGACY_INTEL:-0}" = "1" ] && ! command -v port >/dev/null 2>&1; then
    info "MacPorts is not installed. Install it, then re-run bootstrap:"
    info "  1. Download and install MacPorts: https://www.macports.org/install.php"
    info "  2. Re-run script/bootstrap (it installs the Portsfile and the selected group)"
    info "  3. composer: official phar into ~/.local/bin (https://getcomposer.org/download/)"
    info "  4. op: 1Password CLI standalone from https://developer.1password.com/docs/cli/"
    info "  5. GUI apps: install the cask entries listed below by hand"
    print_cask_checklist
  else
    # shellcheck disable=SC1091 # bin/dot is linted on its own; staged runs exclude it from shellcheck's input
    if source bin/dot | while read -r data; do info "$data"; done
    then
      success "dependencies installed"
    else
      fail "error installing dependencies"
    fi
    if [ "${DOTFILES_LEGACY_INTEL:-0}" = "1" ]; then
      print_cask_checklist
    fi
  fi
fi

echo ''
success 'All installed!'
echo ''
info 'Next steps:'
echo ''
info '  1. Set up 1Password SSH agent:'
info '     1Password → Settings → Developer → Use the SSH agent'
info '     Then add your SSH keys in 1Password and copy public keys as needed'
info '  2. Restore machine-local files: local-restore'
info '     (needs the 1Password CLI; see 1password/functions.zsh)'
info '  3. Sign in to your sync service, let it finish syncing, then run'
# Backticks are literal text here; double quotes would command-substitute.
# shellcheck disable=SC2016
info '     `mackup restore` to bring back app settings (never `mackup link`)'
info '  4. Switch the git remote to SSH so dot can pull:'
info "     git -C $DOTFILES_ROOT remote set-url origin <ssh-url>"
info '  5. Run dot-doctor to verify links, groups and storage'
echo ''

if [ "$(uname -s)" == "Darwin" ]
then
  echo ''
  user 'Some macOS defaults require a restart to take effect. Restart now? [y/N]'
  read -rn 1 restart_answer
  echo ''
  if [ "$restart_answer" = "y" ] || [ "$restart_answer" = "Y" ]
  then
    sudo shutdown -r now
  else
    info 'Restart skipped - remember to restart later for all settings to apply.'
  fi
fi
