cask_args appdir: '/Applications'

# Work group - installed when ~/.localgroups lists "work".
# Never add apps installed by company device management (MDM) here,
# e.g. Company Portal, FortiClient, Microsoft Defender - brew would
# fight the managed installs.

# Third-party taps
tap 'nicoverbruggen/cask'      # PHP Monitor cask
tap 'shivammathur/php'         # PHP Monitor: legacy PHP versions
tap 'shivammathur/extensions'  # PHP Monitor: PHP extensions

# PHP
brew 'php'
brew 'composer'

# Apps
cask 'nicoverbruggen/cask/phpmon'
cask 'phpstorm'
cask 'tableplus'
cask 'sequel-ace'
cask 'postman'
cask 'slack'
cask 'freelens'
cask 'claude'
