#!/usr/bin/env bash
#
# git-add-identity — add a folder-scoped git identity
#
# Usage: git-add-identity
#
# Prompts for a label, name, email, and folder path.
# Creates ~/.gitconfig-<label> and appends an [includeIf] block to ~/.gitconfig.identities.

set -e

GITCONFIG_IDENTITIES="$HOME/.gitconfig.identities"

if [ ! -f "$HOME/.gitconfig.local" ]; then
  echo "Error: ~/.gitconfig.local does not exist. Run script/bootstrap first."
  exit 1
fi

printf "Label (e.g. work): "
read -r label

# Guard against duplicate labels — a second [includeIf] for the same label
# would silently win and orphan the first identity file
if [ -f "$HOME/.gitconfig-$label" ] || grep -q "gitconfig-$label" "$GITCONFIG_IDENTITIES" 2>/dev/null; then
  echo "Error: identity '$label' already exists (~/.gitconfig-$label)."
  echo "Edit $GITCONFIG_IDENTITIES and ~/.gitconfig-$label manually to change it."
  exit 1
fi

printf "Name: "
read -r name

printf "Email: "
read -r email

printf "Folder path (e.g. ~/Projects/Work/): "
read -r folder

# Expand ~ and ensure trailing slash
folder="${folder/#\~/$HOME}"
folder="${folder%/}/"

# A typo'd path means the identity silently never applies — git does not
# warn about [includeIf] blocks that match nothing
if [ ! -d "$folder" ]; then
  echo "Error: folder '$folder' does not exist."
  exit 1
fi

cfg_file="$HOME/.gitconfig-$label"

cat > "$cfg_file" <<EOF
[user]
  name = $name
  email = $email
EOF

cat >> "$GITCONFIG_IDENTITIES" <<EOF

[includeIf "gitdir:$folder"]
  path = $cfg_file
EOF

echo "✓ Identity '$label' added → $folder"
echo "  Config: $cfg_file"
