#!/usr/bin/env bash
#
# Delete all local branches that have been merged into the default branch.

set -euo pipefail

default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')

if [ -z "$default_branch" ]; then
  if git show-ref --verify --quiet refs/heads/main; then
    default_branch=main
  elif git show-ref --verify --quiet refs/heads/master; then
    default_branch=master
  fi
fi

if [ -z "$default_branch" ]; then
  echo "Could not determine default branch" >&2
  exit 1
fi

branches=$(git branch --merged "$default_branch" \
  | grep -v '^\*' \
  | grep -vE '^[[:space:]]*('"$default_branch"'|master)[[:space:]]*$' \
  || true)

if [ -z "$branches" ]; then
  echo "No merged branches to delete."
  exit 0
fi

while IFS= read -r branch; do
  [ -n "$branch" ] && git branch -d "$branch"
done <<< "$branches"
