#!/usr/bin/env bash
#
# dot-doctor — diagnose dotfiles health after install or periodically.
# Usage: dot-doctor

set -euo pipefail

ZSH="${ZSH:-$(cd "$(dirname "$0")/.." && pwd -P)}"
fail=0

# App groups (Brewfile.<group>) — shared parsing with script/install.
# Exported: script/lib/groups.sh reads $DOTFILES_ROOT when sourced.
export DOTFILES_ROOT="$ZSH"
# shellcheck source=../script/lib/groups.sh
# shellcheck disable=SC1091
source "$ZSH/script/lib/groups.sh"

info() { printf "  [ .. ] %s\n" "$1"; }
success() { printf "  [ OK ] %s\n" "$1"; }
warn() { printf "  [WARN] %s\n" "$1"; }
fail() { printf "  [FAIL] %s\n" "$1"; fail=1; }

echo "› dotfiles root: $ZSH"
echo ""

# Git status
if git -C "$ZSH" diff --quiet && git -C "$ZSH" diff --cached --quiet; then
  success "dotfiles repo is clean"
else
  warn "dotfiles repo has uncommitted changes:"
  git -C "$ZSH" status --short | head -n 10 || true
fi

# Expected symlinks, derived from bootstrap's own rules (no hard-coding)
info "checking expected symlinks..."
expected=0
wrong=0

# 1. topic/*.symlink → ~/.<name> (same find as bootstrap install_dotfiles)
while IFS= read -r src; do
  expected=$((expected + 1))
  dst="$HOME/.$(basename "${src%.*}")"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    :
  else
    fail "missing or wrong link: $dst → $src"
    wrong=$((wrong + 1))
  fi
done < <(find -H "$ZSH" -maxdepth 2 -name '*.symlink' -not -path '*/.git/*')

# 2. topic/config/** → ~/.config/<topic>/** (same find as install_config_files)
while IFS= read -r src; do
  expected=$((expected + 1))
  rel="${src#"$ZSH"/}"
  topic="${rel%%/*}"
  subpath="${rel#"$topic"/config/}"
  dst="$HOME/.config/$topic/$subpath"
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    :
  else
    fail "missing or wrong link: $dst → $src"
    wrong=$((wrong + 1))
  fi
done < <(find -H "$ZSH" -mindepth 3 -type f -path '*/config/*' -not -path '*/.git/*' -not -name '*.symlink' -not -name '.DS_Store')

# 3. ~/.ssh/config → ssh/config (created by ssh/install.sh; never read the file)
ssh_dst="$HOME/.ssh/config"
expected=$((expected + 1))
if [ -L "$ssh_dst" ] && [ "$(readlink "$ssh_dst")" = "$ZSH/ssh/config" ]; then
  :
else
  fail "missing or wrong link: $ssh_dst → $ZSH/ssh/config"
  wrong=$((wrong + 1))
fi

if [ "$wrong" -eq 0 ]; then
  success "$expected expected symlinks in place"
fi

# Broken symlinks under ~/.config that point into the repo
broken_config=0
while IFS= read -r link; do
  target="$(readlink "$link")"
  case "$target" in
    "$ZSH"/*)
      if [ ! -e "$link" ]; then
        fail "broken symlink: $link → $target"
        broken_config=$((broken_config + 1))
      fi
      ;;
  esac
done < <(find "$HOME/.config" -maxdepth 3 -type l 2>/dev/null)
if [ "$broken_config" -eq 0 ]; then
  success "no broken ~/.config symlinks into the repo"
fi

# Mackup (same lookup order as Mackup itself: the ~/.mackup.cfg override
# wins, the repo-linked XDG config is the default)
info "checking mackup config..."
if [ -f "$HOME/.config/mackup/mackup.cfg" ]; then
  mackup_cfg="$HOME/.config/mackup/mackup.cfg"
elif [ -f "$HOME/.mackup.cfg" ]; then
  mackup_cfg="$HOME/.mackup.cfg"
fi
if [ -n "${mackup_cfg:-}" ]; then
  if grep -q '^\[applications_to_sync\]' "$mackup_cfg"; then
    # The section must have at least one non-comment, non-empty entry
    # before the next section or EOF.
    if awk '
        /^\[applications_to_sync\]/ { seen = 1; next }
        seen && /^[ \t]*\[/          { exit }
        seen && /^[ \t]*#/           { next }
        seen && NF                   { found = 1; exit }
        END                          { exit (found ? 0 : 1) }
      ' "$mackup_cfg"; then
      success "mackup whitelist present"
    else
      fail "[applications_to_sync] in $mackup_cfg has no entries — nothing would be backed up; fix the whitelist"
    fi
  else
    fail "no [applications_to_sync] in $mackup_cfg — Mackup would back up every supported app (incl. ssh/git/zsh) and fight the dotfiles symlinks"
  fi
  engine="$(sed -n 's/^engine = //p' "$mackup_cfg" | head -n 1)"
  if [ "$engine" = "file_system" ]; then
    mackup_path="$(sed -n 's/^path = //p' "$mackup_cfg" | head -n 1)"
    mackup_dir="$(sed -n 's/^directory = //p' "$mackup_cfg" | head -n 1)"
    mackup_dir="${mackup_dir:-Mackup}"
    case "$mackup_path" in
      Library/CloudStorage/*|"$HOME"/Library/CloudStorage/*)
        success "mackup storage is in a synced folder"
        ;;
      *)
        case "$mackup_path" in
          /*) storage="${mackup_path%/}/$mackup_dir" ;;
          .) storage="$HOME/$mackup_dir" ;;
          *) storage="$HOME/$mackup_path/$mackup_dir" ;;
        esac
        warn "Mackup storage is local-only — not a real backup ($storage)"
        ;;
    esac
  fi
else
  warn "no mackup config found — the ~/.config/mackup/mackup.cfg link is missing (script/bootstrap creates it)"
fi

# App groups (DOTFILES_GROUPS → Brewfile.<group>)
info "checking app groups..."
available="$(dotfiles_available_groups_line)"
requested="$(dotfiles_requested_groups)"
if [ -z "$requested" ]; then
  warn "no DOTFILES_GROUPS set — installing shared apps only (available: $available; set it in ~/.localrc)"
else
  unknown="$(dotfiles_unknown_groups)"
  if [ -n "$unknown" ]; then
    while IFS= read -r g; do
      fail "Unknown group '$g' in DOTFILES_GROUPS. Available: $available"
    done <<<"$unknown"
  else
    while IFS= read -r g; do
      success "group '$g' active (Brewfile.$g)"
    done <<<"$requested"
  fi
fi

# Required tools
info "checking installed tools..."
for tool in atuin bat eza mise starship zsh; do
  if command -v "$tool" >/dev/null 2>&1; then
    success "$tool installed"
  else
    fail "$tool not found in PATH"
  fi
done

# Optional tools
for tool in zoxide fzf fd delta; do
  if command -v "$tool" >/dev/null 2>&1; then
    success "$tool installed"
  else
    warn "$tool not found in PATH (optional)"
  fi
done

# mise status
if command -v mise >/dev/null 2>&1; then
  info "mise tools..."
  mise list --current 2>/dev/null | while read -r line; do
    success "mise: $line"
  done || true
fi

if [ "$fail" -eq 0 ]; then
  echo ""
  success "all checks passed"
else
  echo ""
  fail "some checks failed"
fi

exit "$fail"
